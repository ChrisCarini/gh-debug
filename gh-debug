#!/usr/bin/env bash
set -u

VERSION="0.1.0"
OUTPUT_DIR=${GH_DEBUG_OUTPUT_DIR:-.}

usage() {
  cat <<'USAGE'
gh-debug - collect GitHub CLI and repository diagnostics

USAGE:
  gh debug [--output-dir DIR]

OPTIONS:
  -o, --output-dir DIR  Directory where the markdown report is written (default: current directory)
  -h, --help            Show this help text
      --version         Show the extension version

The extension prints diagnostics to the terminal and writes the same output to an
ISO-8601 timestamped markdown file.
USAGE
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    -o|--output-dir)
      if [ "$#" -lt 2 ]; then
        printf 'error: %s requires a directory\n' "$1" >&2
        exit 2
      fi
      OUTPUT_DIR=$2
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --version)
      printf 'gh-debug %s\n' "$VERSION"
      exit 0
      ;;
    *)
      printf 'error: unknown argument: %s\n\n' "$1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

if ! mkdir -p "$OUTPUT_DIR"; then
  printf 'error: unable to create output directory: %s\n' "$OUTPUT_DIR" >&2
  exit 1
fi

REPORT_TIMESTAMP=$(date -u '+%Y-%m-%dT%H:%M:%SZ')
FILE_TIMESTAMP=$(date -u '+%Y-%m-%dT%H-%M-%SZ')
REPORT_PATH="$OUTPUT_DIR/gh-debug-$FILE_TIMESTAMP.md"

redact() {
  sed -E \
    -e 's#(https?://)[^/@[:space:]]+@#\1***@#g' \
    -e 's#(gh[pousr]_[A-Za-z0-9_]+)#***#g' \
    -e 's#(github_pat_[A-Za-z0-9_]+)#***#g'
}

emit() {
  printf '%s\n' "$*" | tee -a "$REPORT_PATH"
}

have_command() {
  command -v "$1" >/dev/null 2>&1
}

inside_git_work_tree() {
  have_command git && git rev-parse --is-inside-work-tree >/dev/null 2>&1
}

run_check() {
  title=$1
  shift

  emit ""
  emit "## $title"
  emit ""
  emit '```console'
  emit "\$ $*"

  output=$("$@" 2>&1)
  status=$?
  if [ -n "$output" ]; then
    printf '%s\n' "$output" | redact | tee -a "$REPORT_PATH"
  fi
  emit "exit status: $status"
  emit '```'
  return 0
}

run_skip() {
  title=$1
  reason=$2

  emit ""
  emit "## $title"
  emit ""
  emit "Skipped: $reason"
}

: > "$REPORT_PATH"
emit "# GitHub Debug Report"
emit ""
emit "Generated at: $REPORT_TIMESTAMP"
emit "Report path: $REPORT_PATH"

if have_command gh; then
  run_check "GitHub CLI Version" gh --version
  run_check "GitHub CLI Authentication" gh auth status
  run_check "GitHub API User" gh api /user
  run_check "GitHub API Rate Limit" gh api /rate_limit
  run_check "GitHub API Metadata" gh api /meta
  run_check "Current GitHub Repository" gh repo view --json nameWithOwner,defaultBranchRef,viewerPermission,isPrivate
else
  run_skip "GitHub CLI Checks" "gh is not installed or is not on PATH"
fi

if have_command git; then
  run_check "Git Version" git --version
  if inside_git_work_tree; then
    run_check "Git Repository Status" git status --short --branch
    run_check "Git Remotes" git remote -v
    run_check "GitHub Origin URL" git config --get remote.origin.url
    run_check "Git User Name" git config --get user.name
    run_check "Git User Email" git config --get user.email
  else
    run_skip "Git Repository Checks" "current directory is not inside a git work tree"
  fi
else
  run_skip "Git Checks" "git is not installed or is not on PATH"
fi

emit ""
emit "Report written to $REPORT_PATH"
